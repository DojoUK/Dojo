# Nothing in this file is required to run Dojo — see SELF_HOSTING.md.
# Copy this to .env and uncomment/fill in only what you want to change from
# the defaults in docker-compose.yml.

DEBUG=True

# SECRET_KEY is not needed here — it auto-generates on first boot and
# persists to .secret_key. Only set it if you need a specific key (e.g.
# restoring onto a new host without carrying .secret_key across).
# SECRET_KEY=

DB_NAME=dojo
DB_USER=dojo_user
DB_PASSWORD=your-password-here
DB_ROOT_PASSWORD=your-root-password-here

# Comma-separated list of domains this instance serves, e.g. dojo.yourclub.com
# Required when DEBUG=False — Django refuses all requests without it.
# Cookies, CSRF, and HSTS are also only enforced when DEBUG=False.
ALLOWED_HOSTS=

# Email — each club chooses how its email is sent in the setup wizard or
# Settings → Email. These EMAIL_* settings are only a fallback for clubs that
# haven't chosen; leave them blank to print that mail to the docker logs.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=<no-reply@example.com>
# "Built-in mail server" email option (the `mail` container): the hostname it announces.
# Point it, and your server's reverse DNS, at your server.
MAIL_HOSTNAME=mail.example.com
# Where Dojo finds its mail service; only change if you run your own relay.
# DOJO_MAIL_HOST=mail
# DOJO_MAIL_PORT=25

# Stripe — each club now enters its own keys in the setup wizard or
# Settings → Payments. These are only a fallback for clubs that haven't.
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook secret — from `stripe listen --forward-to localhost:8000/stripe/webhook/`
STRIPE_WEBHOOK_SECRET=whsec_...

# Dojo club network
# A Google Maps API key with the Maps JavaScript and Geocoding APIs enabled. It shows the
# map in the club finder (/clubs/) and turns club and member addresses into map positions.
# Restrict it to your site's address in the Google Cloud console. Leave blank to list clubs
# without a map (members then use their device's location, and clubs type in coordinates).
GOOGLE_MAPS_API_KEY=
# The Map ID for the club finder's maps (Google Cloud console > Map Management, a JavaScript
# map). Dojo's logo map pins need one. Leave blank to use Google's DEMO_MAP_ID, fine for testing.
GOOGLE_MAPS_MAP_ID=
# True lets anyone register a new club on this installation at /setup/; otherwise only superusers can.
DOJO_OPEN_CLUB_REGISTRATION=False
# Local testing: where the stripe container forwards test events. Use your
# club's own webhook address to test Settings → Payments (see SELF_HOSTING.md).
# STRIPE_FORWARD_TO=http://web:8000/stripe/webhook/your-club/

# Public URL — used to build links in emails and Stripe redirects
SITE_URL=https://yourdomain.com

# Club websites allowed to send membership applications to /api/join/<club>/,
# comma-separated, e.g. https://www.yourclub.org.uk. Write <club>=<address>
# (e.g. my-club=https://www.myclub.org.uk) to allow a website for one club only.
# Leave blank if you only use Dojo's own join page.
SIGNUP_API_ORIGINS=
# Applications the signup API accepts from one address per hour (default 5).
SIGNUP_API_RATE_LIMIT=

# Whether a reverse proxy (Caddy, nginx) handles HTTPS in front of Dojo, so Dojo
# trusts the proxy's X-Forwarded-Proto header, and the last address in its
# X-Forwarded-For header for the signup API's rate limit. Left blank, it's on
# whenever SITE_URL starts with https://. Set it to false if nothing sits in front.
TRUST_PROXY_HTTPS=

# Version shown under Settings > General. Read from the .git folder when there is one;
# set these only if your image is built without it (e.g. in CI). DOJO_BUILD_REPO is
# "owner/name" or a GitHub URL; anything other than DojoUK/Dojo shows as an unofficial fork.
DOJO_BUILD_REPO=
DOJO_BUILD_COMMIT=
DOJO_BUILD_TAG=

# Dojo licence — leave blank for AGPL-3.0 (open source / self-hosted)
# Set both to display a commercial licence notice in the app
DOJO_LICENCE_KEY=
DOJO_LICENCE_HOLDER=